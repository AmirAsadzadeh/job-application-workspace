{
  "name": "@workspace/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@archiver/archiver": "^0.2.0",
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@better-auth/oauth-provider": "^1.7.3",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@workspace/domain": "*",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "file-type": "^22.0.2",
    "nodemailer": "^10.0.3",
    "pg": "^8.23.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.2.4",
    "drizzle-kit": "^0.31.10"
  }
}
