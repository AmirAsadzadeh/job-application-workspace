{
  "name": "job-positions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/cli.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build --configLoader native",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "desktop:prepare": "npm run build && npm run build:sidecar",
    "start": "tsx server/cli.ts --production",
    "preview": "tsx server/cli.ts --production",
    "tauri": "tauri",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tauri.ps1 dev",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tauri.ps1 build",
    "tauri:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tauri.ps1 check",
    "tauri:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tauri.ps1 test",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "test:performance": "vitest run --configLoader native server/positionsPerformance.test.ts src/features/positions/components/PositionList.performance.test.tsx"
  },
  "dependencies": {
    "@archiver/archiver": "^0.2.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vitejs/plugin-react": "^5.0.0",
    "csv-stringify": "^6.8.3",
    "file-type": "^22.0.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  }
}
